{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "serve",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "visualcut",
        "serve"
      ],
      "port": 8765
    },
    {
      "name": "serve-nosync",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "visualcut",
        "serve",
        "--port",
        "8766"
      ],
      "port": 8766
    }
  ]
}
